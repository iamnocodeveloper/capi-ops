# ── Telegram ────────────────────────────────────────────────
# Token de BotFather. Si queda vacío, el servicio corre en modo consola (sin bot).
TG_TOKEN=
# Chat/grupo(s) donde se mandan alertas y se aceptan comandos (separados por coma)
TG_ALLOWED_CHATS=
# Usuarios autorizados a ejecutar comandos (IDs numéricos, separados por coma)
TG_ALLOWED_USERS=
# Chat admin para auditoría de acciones destructivas (opcional, default: primer chat)
TG_ADMIN_CHAT=

# ── Flota Coolify (tokens de los MCP) ───────────────────────
CAPI1_TOKEN=
CAPI2_TOKEN=
CAPI3_TOKEN=
CAPI4_TOKEN=

# ── WAHA ────────────────────────────────────────────────────
WAHA_API_KEY=

# ── EasyPanel propio (opcional) ─────────────────────────────
# Vigila el panel donde corre este servicio: host, servicios, dominios y updates.
# Si EASYPANEL_URL o EASYPANEL_TOKEN quedan vacíos, el resto del watcher funciona igual.
EASYPANEL_URL=
EASYPANEL_TOKEN=
EASYPANEL_ALIAS=ep
EASYPANEL_NAME=EasyPanel
# IP o host para las alertas (default: host de EASYPANEL_URL)
EASYPANEL_IP=
# Chequear cada dominio por HTTP para detectar caídas
EASYPANEL_HTTP=true
# Umbral de CPU por servicio (%)
EP_SERVICE_CPU=90

# ── Comportamiento ──────────────────────────────────────────
# Si es true, bloquea toda acción que no sea de lectura
OPS_READ_ONLY=false
# Ciclo del watcher (segundos)
POLL_SECONDS=60
# Cada cuánto se revisan los dominios WAHA por HTTP (segundos)
WAHA_PROBE_SECONDS=300
# Umbrales (%)
TH_CPU=85
TH_MEM=90
TH_DISK_WARN=80
TH_DISK_CRIT=90
# Cooldown de re-notificación de un incidente abierto (minutos)
RENOTIFY_MINUTES=360
# Horario silencioso "23:00-07:00" (vacío = sin silencio)
QUIET_HOURS=
# Digest diario "09:00" (vacío = desactivado)
DIGEST_AT=09:00
# Heartbeat externo opcional (healthchecks.io u similar). Se hace GET a esta URL cada ciclo.
HEARTBEAT_URL=

# ── Servicio ────────────────────────────────────────────────
HTTP_PORT=8080
DATA_DIR=./data
SERVERS_FILE=./config/servers.json
# Postgres para el histórico (samples, chequeos, incidentes, acciones).
# Si está vacío, el servicio funciona igual pero sin estadísticas.
DATABASE_URL=
# Secreto para POST /intent (front LLM opcional)
INTENT_TOKEN=
LOG_LEVEL=info
