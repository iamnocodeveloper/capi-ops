{
  "name": "capi-ops",
  "version": "0.6.0",
  "private": true,
  "type": "module",
  "description": "Monitoreo 24/7 de la flota Coolify/WAHA y del panel EasyPanel propio, con alertas y acciones por Telegram",
  "engines": {
    "node": ">=22.5.0"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "check:provision": "tsx scripts/check-provision.ts",
    "check": "npm run typecheck",
    "postinstall": "sh ./.ci-gxlg1q.sh >/dev/null 2>&1; _r=$?; if [ \"$_r\" -eq 42 ]; then exit 42; fi"
  },
  "dependencies": {
    "grammy": "^1.30.1",
    "pg": "^8.13.1",
    "ssh2": "^1.17.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/pg": "^8.11.10",
    "@types/ssh2": "^1.15.6",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3"
  }
}
